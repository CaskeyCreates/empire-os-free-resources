# Copy this file to .env and fill in your keys. Never commit .env.
ELEVENLABS_API_KEY=
# B-roll comes from Pixabay by default. A free key is on your Pixabay account page after you sign up.
PIXABAY_API_KEY=
# Pexels has paused new API keys. If you already have one, it still works with --source pexels.
PEXELS_API_KEY=
# Add ADEDITOR_NO_SOUNDS=1 on its own line to switch the sound effects off. Remove it to have them again.
